// AI Business Representative Platform — Prisma schema
// Two-tier data model:
//   Tier 1 (operator-readable): User.name, contactMethod, contactValue, feedback
//   Tier 2 (zero-knowledge vault): VaultEntry.ciphertext + iv — encrypted client-side
// Even the platform operator (Hashim) cannot read Tier 2 contents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())

  // ===== TIER 1: Operator-readable (Hashim can see) =====
  email         String?  @unique // for login + magic-link fallback
  name          String?  // user's display name (Hashim can see)
  contactMethod String   @default("email") // "email" | "phone" | "whatsapp"
  contactValue  String?  // phone number or email — so Hashim can talk to them
  feedback      String?  // optional user-submitted feedback

  // ===== Auth (v1: email + passphrase; passkey upgrade later) =====
  // Server stores ONLY the verifier (salt + derived hash), never the passphrase.
  authSalt      String?  // per-user random salt for auth hash
  authVerifier  String?  // derived verifier (PBKDF2 hash of passphrase, server-side check is for auth only)
  // NOTE: the SAME passphrase is also used client-side to derive the vault key.
  // The server never sees the vault key — only the verifier for login.

  // ===== Vault crypto metadata (operator sees existence, not contents) =====
  vaultSalt     String?  // per-user salt for vault key derivation (separate from authSalt)
  vaultKeyBlob  String?  // vault key encrypted with recovery-code-derived key (Option B recovery)
  recoverySalt  String?  // salt for recovery code key derivation

  // ===== Status & roles =====
  status        String   @default("ACTIVE") // ACTIVE | SUSPECTED | SUSPENDED | TERMINATED
  tier          String   @default("FREE")   // FREE | PRO | ELITE
  role          String   @default("USER")   // USER | ADMIN

  // ===== Wallet / commission =====
  // Early adopter flag is LOCKED at signup based on user count.
  // First 10 users get 28% fee rate for life; everyone else gets 35%.
  isEarlyAdopter Boolean  @default(false)
  feeRateLocked  Float    @default(0.35) // locked at signup — never changes for this user

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vaultEntries  VaultEntry[]
  sessions      Session[]
  flagsFiled    MisuseFlag[]  @relation("flaggedUser")
  flagsRaised   MisuseFlag[]  @relation("flaggedBy")
  matchedPosts  MarketplacePost[] @relation("matchedCreator")
  wallet        Wallet?
  withdrawalRequests WithdrawalRequest[]
}

model VaultEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Encrypted with user's vault key (AES-GCM, client-side).
  // Server stores only ciphertext + IV. Never decrypted server-side.
  ciphertext  String   // base64
  iv          String   // base64

  // Operator-visible metadata (structure only, never contents)
  entryType   String   // "skill" | "pricing" | "portfolio" | "note" | "apikey"
  label       String   // user-supplied short label (e.g. "Next.js", "Hourly floor", "X API key") — stored in plaintext so admin panel can show structure. Sensitive VALUE stays encrypted.
  sortIndex   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, entryType])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique // 32-byte hex
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

model MisuseFlag {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("flaggedUser", fields: [userId], references: [id], onDelete: Cascade)
  raisedById  String?
  raisedBy    User?    @relation("flaggedBy", fields: [raisedById], references: [id])

  reason      String   // short reason code: "spam_outreach" | "fraud_signal" | "tos_violation" | "manual_review"
  severity    String   @default("LOW") // LOW | MEDIUM | HIGH
  status      String   @default("OPEN") // OPEN | REVIEWED | RESOLVED | DISMISSED
  context     String?  // JSON-encoded details

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model MarketplacePost {
  // Layer 1: inbound marketplace where clients post project briefs.
  id              String   @id @default(cuid())
  clientName      String?
  clientContact   String   // phone or email — so the matched creator can reach them
  brief           String   // what they need
  budget          String?
  timeline        String?
  requiredSkills  String?  // comma-separated tags for AI matching

  status          String   @default("OPEN") // OPEN | MATCHED | CLOSED
  matchedUserId   String?
  matchedUser     User?    @relation("matchedCreator", fields: [matchedUserId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model LeadCache {
  // Aggregated leads from Layer 2 free sources (HN, RSS, etc.)
  id          String   @id @default(cuid())
  source      String   // "hn" | "rss_weworkremotely" | etc.
  externalId  String   // unique ID from the source
  title       String
  body        String
  url         String
  author      String?
  postedAt    DateTime
  fetchedAt   DateTime @default(now())

  status      String   @default("NEW") // NEW | QUALIFIED | ARCHIVED | DRAFTED

  @@unique([source, externalId])
  @@index([source, status])
}

// ===== Wallet / Ledger =====
// Krypta is a ledger, not a payment processor. The wallet tracks earnings
// from completed milestones and processes withdrawal requests. All real
// money movement happens off-platform, fulfilled manually by Hashim via
// the user's chosen withdrawal method (JazzCash, EasyPaisa, NayaPay, Paytm,
// PayPal, bank wire, etc.).

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // All amounts stored in integer cents to avoid float precision issues.
  // Display in USD (or local equivalent at withdrawal time).
  balanceCents           Int @default(0)
  lifetimeEarningsCents  Int @default(0)
  lifetimeFeesCents      Int @default(0)
  lifetimeWithdrawnCents Int @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    Transaction[]
}

model Transaction {
  id              String   @id @default(cuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId          String   // denormalized for easy querying

  type            String   // "deposit" | "withdrawal" | "fee" | "adjustment"
  // deposit: positive (earnings added to wallet)
  // withdrawal: negative (gross amount leaving on user request)
  // fee: negative (operator cut deducted at withdrawal)
  // adjustment: signed (manual correction by Hashim)

  amountCents     Int      // signed: + for credits, - for debits
  description     String?

  // For deposits: reference to the project / milestone
  projectRef      String?

  // For withdrawals: link to the WithdrawalRequest
  withdrawalRequestId String?

  status          String   @default("COMPLETED") // PENDING | COMPLETED | FAILED | REVERSED

  createdAt       DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, type])
}

model WithdrawalRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Amounts in integer cents (USD at request time)
  grossCents      Int      // amount user requested
  feeCents        Int      // operator cut (28% or 35% of gross)
  netCents        Int      // amount user will receive (gross - fee)

  feeRate         Float    // snapshot of feeRateLocked at request time
  isEarlyAdopter  Boolean  // snapshot of early-adopter status

  // Withdrawal method — stored as methodType + label (visible to operator).
  // The full method details (phone, account number, etc.) live encrypted
  // in the user's VaultEntry with entryType="withdrawal_method".
  // Hashim contacts the user to confirm full details before payout.
  methodType      String   // "jazzcash" | "easypaisa" | "nayapay" | "paytm" | "upi" | "paypal" | "bank" | "other"
  methodLabel     String   // human-readable, e.g. "JazzCash +92 300 1234567"
  methodVaultEntryId String? // reference to the VaultEntry containing the encrypted details

  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAID | FAILED
  adminNotes      String?
  processedAt     DateTime?

  createdAt       DateTime @default(now())

  @@index([status])
  @@index([userId])
}
